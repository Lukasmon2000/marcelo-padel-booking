# Frontend variables. These can be public only if RLS is correctly configured in Supabase.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Do NOT put these in the frontend .env.
# Configure them as Supabase Edge Function Secrets instead:
# BREVO_API_KEY=
# BREVO_SENDER_EMAIL=
# BREVO_SENDER_NAME=Marcelo Pádel
# ADMIN_EMAIL=
# CRON_SECRET=
# SUPABASE_SERVICE_ROLE_KEY=
# PUBLIC_SITE_URL=https://tu-dominio.com
